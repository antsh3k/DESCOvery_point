# Copy this file to .env and fill in the values. .env is gitignored — never commit it.

# --- LLM provider -----------------------------------------------------------
# Default provider to use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Scraper (Tier-2 fallback) ----------------------------------------------
# Fallback for JS-heavy / bot-protected sites, via Claude's server-side
# web_fetch tool (uses ANTHROPIC_API_KEY above): "claude" or "off".
SCRAPE_TIER2=claude

# --- Enrichment (supplemental firmographics) --------------------------------
# After website extraction, search the web (LinkedIn / PitchBook / Crunchbase /
# news) for headcount, revenue, ownership, and investors, via Claude's
# server-side web_search tool: "claude" or "off".
ENRICH_SOURCE=claude

# --- Database (Postgres) ----------------------------------------------------
POSTGRES_USER=descovery
POSTGRES_PASSWORD=descovery
POSTGRES_DB=descovery_point
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://descovery:descovery@localhost:5432/descovery_point

# --- App --------------------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
