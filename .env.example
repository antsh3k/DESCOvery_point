# Copy this file to .env and fill in the values. .env is gitignored — never commit it.

# --- LLM provider -----------------------------------------------------------
# Default provider to use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Database (Postgres) ----------------------------------------------------
POSTGRES_USER=thesis
POSTGRES_PASSWORD=thesis
POSTGRES_DB=thesis_match
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://thesis:thesis@localhost:5432/thesis_match

# --- App --------------------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
